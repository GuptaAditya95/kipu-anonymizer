# Copy to .env (never commit .env)
SOURCES_URL=https://reto-pii-fuentes-production.up.railway.app/v1
SOURCES_TOKEN=your-personal-token-from-/evento/reto
# Secret salt for deterministic pseudonyms. Set once, never change after run #1.
SALT=generate-a-long-random-string
# Where raw data, output and the pseudonym map live (mount a persistent volume here in prod)
DATA_DIR=./data
# Jev (TypeSafe decision model) through OpenRouter: unknown occupations + leftover spans.
# Leave empty to run rules-only (everything still works).
OPENROUTER_API_KEY=
JEV_MODEL=jev-1.13
JEV_TIMEOUT=4
JEV_MIN_CONFIDENCE=0.6
PORT=9000

# Review dashboard (http://localhost:9000/v1/review?key=...). Disabled when empty.
REVIEW_KEY=
# Reasoning model for review cases (OpenRouter slug; check the exact name in OpenRouter's list)
REASONING_MODEL=anthropic/claude-sonnet-4.5
# Verification after each /run (1 = on, 0 = off). Never delays the judge: runs after "done".
VERIFY=1
VERIFY_LOW=0.2
VERIFY_HIGH=0.7
VERIFY_WORKERS=16
